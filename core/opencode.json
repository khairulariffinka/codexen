{
  "$schema": "https://opencode.ai/config.json",

  "_comment": "CodeXen config — remove _comment lines, add provider if needed",

  "lsp": true,
  "formatter": true,

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "instructions": [
    "AGENTS.md",
    "docs/context/*.md",
    "docs/architecture.md"
  ],
  "_note": "Runtime-generated by init-project skill — not part of this repo. Delete if not using CodeXen memory system.",

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "list": "allow",
    "task": {
      "*": "allow"
    },
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },

  "agent": {
    "codexen": {
      "description": "The Complete AI Framework for OpenCode — 24 agents, 19 skills, 11 commands for planning, coding, auditing, and deployment",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "list": "allow",
        "task": {
          "*": "allow"
        },
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "research": {
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "planner": {
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "coder": {
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "auditor": {
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "security": {
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
